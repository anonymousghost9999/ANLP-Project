best_deberta_prompt_scorer/*.pt
best_prompt_scorer/*.pt
fine_tuned_prompt_scorer/*.safetensors
fine_tuned_prompt_scorer/*.bin
checkpoint-*/

# Training Logs & Cluster SLURM Output
*.out
*.err
*.log
runs/
wandb/

# Caches & Temporary Files
.cache/
.pytest_cache/
hf_cache/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
